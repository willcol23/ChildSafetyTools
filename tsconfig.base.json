{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@packages/*": ["packages/*/src"],
      "@utils/*": ["packages/utils/src/*"],
      "@schemas/*": ["packages/schemas/src/*"]
    },
    "composite": true,
    "skipLibCheck": true,
    "strict": true,
    "moduleResolution": "node",
    "esModuleInterop": true,
    "resolveJsonModule": true
  }
}
